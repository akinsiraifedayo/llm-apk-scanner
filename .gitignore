.DS_Store

# Project artefacts that must not be committed
# APK corpus - ignore binaries and results, track documentation
/corpus/apks/
/corpus/results/
/corpus/stats/
/corpus/staging/
/apks/
/extracted/
/decoded/

# Streaming-run state. The ledger is regenerable from the manifest and is
# per-machine, so it is not shared; corpus/frame.csv and corpus/manifest.csv
# ARE tracked, since they define the reproducible sample.
/corpus/ledger.db
/corpus/ledger.db-wal
/corpus/ledger.db-shm

# macOS AppleDouble sidecars. These match *.apk but are 163-byte metadata
# stubs, not archives; globbing them as APKs caused a 100%-failure scan run.
._*
.DS_Store

# Scan results may contain leaked credentials — never commit
results/
reports/
*.findings.json
*.findings.md

# AndroZoo API keys and configuration
.androzoo
.env
.env.*
# AndroZoo access-grant email (contains a live API key — never commit)
submissions/androzoo_response.txt

# Validated credentials database (intentionally never written, but defensive)
*.creds.db

# Ethics evidence and disclosure correspondence (private)
ethics/private/
disclosures/private/

# Dissertation drafts in proprietary formats (use markdown source of truth)
*.docx
*.pdf
*.odt
!research_proposal.html

# Validation binaries and labels. The labels are ground truth (keep them in
# the repo); the APKs are corpus binaries and must never be committed.
/validation/apks/
/validation/ledger.db
/validation/ledger.db-wal
/validation/ledger.db-shm
/validation/detail/
data/staging/

# AndroZoo index snapshots - multi-GB, re-downloadable, never commit
/corpus/androzoo_index_*.csv.gz
/corpus/androzoo_index_*.sha256

# Adversarial-audit transcripts. These quote raw strings pulled from corpus
# APKs, including live-format provider credentials, so they are evidence held
# locally and never committed (docs/DATA_HANDLING.md §6).
/audit_full.txt
/audit_full.err
/audit_*.txt
/audit_*.err

# Any aggregate or scan output written to the repo root
/findings*.jsonl
/*_aggregate.json

# Assembled document builds. Regenerated by scripts/build_document.py from the
# chapter sources, which are the record; the outputs are not.
/dissertation/build/

# Corpus ledgers and the identified analysis outputs. Both name the
# application behind each finding; findings/ holds the anonymised copies.
/corpus/
/validation/
